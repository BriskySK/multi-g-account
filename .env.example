# ── Server ────────────────────────────────────────────────────────────────────
# Port the Node server listens on (behind Caddy; not exposed publicly)
PORT=3000

# Public HTTPS base URL of this server — the domain you point at Caddy.
# The OAuth redirect URI becomes <PUBLIC_URL>/oauth/callback and must match
# the redirect URI configured in Google Cloud Console exactly.
PUBLIC_URL=https://mcp.example.com

# Bare domain for Caddy (docker-compose only) — same host as PUBLIC_URL, no scheme.
MCP_DOMAIN=mcp.example.com

# ── Secrets (generate your own, never commit real values) ─────────────────────
# API key Claude sends to authenticate to this server (min 32 chars).
# Generate: openssl rand -hex 32
# Use hex, not base64 — base64's `+`/`/` characters have been observed getting
# silently mangled by at least one Claude connector header-input field.
MCP_API_KEY=

# 32-byte key encrypting Google tokens at rest, as 64 hex characters.
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ── Google OAuth client (from Google Cloud Console → Credentials) ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Storage ───────────────────────────────────────────────────────────────────
# SQLite file holding encrypted tokens. In Docker this lives on the data volume.
DB_PATH=./data/multi-g-account.db
